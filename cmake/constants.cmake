include_guard(GLOBAL)

# Capture the provider location, not the requesting component's directory.
set_property(GLOBAL PROPERTY ESPIDFADA_CONSTANTS_DIR "${CMAKE_CURRENT_LIST_DIR}/..")

function(espidfada_generate_constants)
    get_property(_provider GLOBAL PROPERTY ESPIDFADA_CONSTANTS_DIR)
    cmake_parse_arguments(PROBE "" "NAME;SOURCE;PACKAGE;OUT_TARGET" "" ${ARGN})
    if(PROBE_UNPARSED_ARGUMENTS OR PROBE_KEYWORDS_MISSING_VALUES OR
       NOT PROBE_NAME OR NOT PROBE_SOURCE)
        message(FATAL_ERROR "espidfada_generate_constants requires NAME and SOURCE")
    endif()
    if(NOT PROBE_NAME MATCHES "^[A-Za-z][A-Za-z0-9_]*$")
        message(FATAL_ERROR "Invalid constants registration NAME: ${PROBE_NAME}")
    endif()
    if(NOT PROBE_PACKAGE)
        set(PROBE_PACKAGE "ESPIDF.Constants.${PROBE_NAME}")
    endif()
    if(NOT PROBE_PACKAGE MATCHES "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)*$")
        message(FATAL_ERROR "Invalid constants PACKAGE: ${PROBE_PACKAGE}")
    endif()
    get_filename_component(_source "${PROBE_SOURCE}" ABSOLUTE BASE_DIR "${COMPONENT_DIR}")
    if(NOT EXISTS "${_source}")
        message(FATAL_ERROR "Constants probe does not exist: ${_source}")
    endif()
    string(TOLOWER "${PROBE_PACKAGE}" _filename)
    string(REPLACE "." "-" _filename "${_filename}")
    set(_output "${COMPONENT_DIR}/.gens/${_filename}.ads")
    get_property(_outputs GLOBAL PROPERTY ESPIDFADA_CONSTANTS_OUTPUTS)
    if(_output IN_LIST _outputs)
        message(FATAL_ERROR "Duplicate constants output registration: ${_output}")
    endif()
    set_property(GLOBAL APPEND PROPERTY ESPIDFADA_CONSTANTS_OUTPUTS "${_output}")
    string(SHA256 _id "${_output}")
    set(_target "espidfada_constants_${_id}")
    set(_probe "${_target}_probe")
    add_library("${_probe}" OBJECT "${_source}")
    get_target_property(_kind "${COMPONENT_LIB}" TYPE)
    if(_kind STREQUAL "INTERFACE_LIBRARY")
        set(_scope "INTERFACE_")
        set(_links INTERFACE_LINK_LIBRARIES)
    else()
        set(_scope "")
        set(_links LINK_LIBRARIES)
    endif()
    foreach(_property INCLUDE_DIRECTORIES COMPILE_DEFINITIONS COMPILE_OPTIONS)
        set_property(TARGET "${_probe}" PROPERTY "${_property}"
            "$<TARGET_PROPERTY:${COMPONENT_LIB},${_scope}${_property}>")
    endforeach()
    target_link_libraries("${_probe}" PRIVATE
        "$<TARGET_PROPERTY:${COMPONENT_LIB},${_links}>")
    target_include_directories("${_probe}" PRIVATE "${_provider}/include")
    # The explicit option also overrides application-wide -flto flags.
    set_property(TARGET "${_probe}" PROPERTY INTERPROCEDURAL_OPTIMIZATION FALSE)
    target_compile_options("${_probe}" PRIVATE -fno-lto)
    idf_build_get_property(_python PYTHON)
    set(_generator "${_provider}/tools/generate_constants.py")
    add_custom_command(OUTPUT "${_output}"
        COMMAND "${_python}" "${_generator}" --nm "${CMAKE_NM}"
            --object $<TARGET_OBJECTS:${_probe}>
            --package "${PROBE_PACKAGE}" --output "${_output}"
        DEPENDS "${_probe}" $<TARGET_OBJECTS:${_probe}> "${_generator}"
        COMMAND_EXPAND_LISTS VERBATIM)
    add_custom_target("${_target}" DEPENDS "${_output}")
    if(NOT TARGET espidfada_constants)
        add_custom_target(espidfada_constants)
    endif()
    add_dependencies(espidfada_constants "${_target}")
    if(PROBE_OUT_TARGET)
        set("${PROBE_OUT_TARGET}" "${_target}" PARENT_SCOPE)
    endif()
endfunction()
